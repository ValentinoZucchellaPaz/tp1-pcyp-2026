@startuml diagrama-secuencia-3-salidas
title TP1 — 3) Terminaciones que no son el camino feliz
autonumber

participant "ValidationWorker" as VW
participant "PrintingWorker" as PW
participant "QualityControlWorker" as QW
participant "OutcomeDecider (api)" as OD
participant "PrinterPool" as PP
participant "EventLog" as EL
participant "TerminationTracker" as TT

== Modelo inválido: rechazo ==
VW -> OD : isModelValid(id, config) : false
VW -> EL : WAITING_VALIDATION -> REJECTED
VW -> PP : release(printerId)
VW -> TT : orderCompleted()

== Fallo de impresión ==
PW -> OD : isPrintSuccessful(id, config) : false
PW -> EL : READY_TO_PRINT -> PRINT_FAILED
PW -> PP : markOutOfService(printerId)
PW -> TT : orderCompleted()

== Control de calidad: defectuoso ==
QW -> OD : isQualityApproved(id, config) : false
QW -> EL : PRINTED -> DEFECTIVE
QW -> TT : orderCompleted()

note over PP
  release: la impresora vuelve a AVAILABLE
  y devuelve su permiso al semáforo.
  markOutOfService: pasa a OUT_OF_SERVICE
  y NO devuelve el permiso (no se reutiliza).
end note

@enduml
