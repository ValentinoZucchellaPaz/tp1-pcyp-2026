@startuml diagrama-secuencia-4-terminacion
title TP1 — 4) Terminación en cascada (píldoras)

actor ConcurrentSimulation as CS
participant "createdQueue" as CQ
participant "AssignmentWorker (x3)" as AW
participant "StageBarrier (asignación)" as BA
participant "validationQueue" as VQ
participant "TerminationTracker" as TT
participant "EventLog" as EL

CS -> CQ : offerPoison(3) (siembra inicial, tras las órdenes reales)
note right of CQ : una píldora por worker; van al final de la FIFO

AW -> CQ : take()
CQ --> AW : POISON (WorkItem.isPoison())

AW -> BA : workerFinished()
alt workerFinished() == false
    BA --> AW : false
    note right of AW : el worker termina; no propaga
else workerFinished() == true  (soy el último de la etapa)
    BA --> AW : true
    AW -> AW : onLastWorkerFinished()
    AW -> VQ : offerPoison(nextWorkerCount = 2)
end

note over CQ, VQ
  Las etapas validación -> impresión -> calidad repiten el mismo patrón:
  el último worker (workerFinished() = true) inserta nextWorkerCount
  píldoras en la cola siguiente. Calidad no tiene sucesora: no propaga.
end note

== Terminación global == 

CS -> TT : awaitAll()  (espera las N órdenes)
TT --> CS : notifyAll() al llegar a N
CS -> TT : rethrowFailure()  (relanza si hubo fallo)
CS -> CS : joinAll()  (espera los 10 hilos)
CS -> EL : close()
CS -> CS : buildResult()  (elementos.csv, resumen.properties)

@enduml
