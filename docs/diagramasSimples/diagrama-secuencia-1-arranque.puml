@startuml diagrama-secuencia-1-arranque
title TP1 — 1) Arranque conjunto (StartGate)
autonumber

actor Main
participant ConcurrentSimulation as CS
participant WorkerGroup as WG
participant StartGate as SG
participant "AssignmentWorker (3)" as AW
participant "ValidationWorker (2)" as VW
participant "PrintingWorker (3)" as PW
participant "QualityControlWorker (2)" as QW

Main -> CS : execute(config)
CS -> WG : add(nombre, tarea) x10 (registerWorkers)
CS -> WG : startAll()
WG -> AW : start()
WG -> VW : start()
WG -> PW : start()
WG -> QW : start()

note over WG
  start() lanza el hilo; la JVM invoca
  run() dentro del hilo nuevo
  (AbstractStageWorker.run), que
  empieza con awaitOpen().
end note

AW -> SG : awaitOpen()
VW -> SG : awaitOpen()
PW -> SG : awaitOpen()
QW -> SG : awaitOpen()

CS -> SG : openWhenAllWorkersAreReady()
SG --> AW : notifyAll() (open = true)
SG --> VW : notifyAll()
SG --> PW : notifyAll()
SG --> QW : notifyAll()

note over SG
  Ninguna etapa procesa una orden
  hasta que TODAS las etapas se
  registraron. El arranque es conjunto.
end note

@enduml
